# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية. لا تضع أي قيمة حقيقية
# داخل هذا الملف (.env.example) ولا ترفع .env.local إلى GitHub أبداً.

# رابط الاتصال المباشر بقاعدة بيانات Postgres (من Supabase لاحقاً، أو محلي
# أثناء التطوير). يُستعمل من كود الخادم فقط ولا يظهر أبداً في المتصفح.
DATABASE_URL="postgres://user:password@host:5432/database"

# (اختياري) الرابط العام لمخزن الصور في Supabase Storage. إن تُرك فارغاً
# أثناء التطوير، تُقرأ الصور التجريبية من public/demo-images محلياً.
NEXT_PUBLIC_SUPABASE_STORAGE_URL=""

# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية. لا تضع أي قيمة حقيقية
# داخل هذا الملف (.env.example) ولا ترفع .env.local إلى GitHub أبداً.

# رابط الاتصال المباشر بقاعدة بيانات Postgres (من Supabase لاحقاً، أو محلي
# أثناء التطوير). يُستعمل من كود الخادم فقط ولا يظهر أبداً في المتصفح.
DATABASE_URL="postgres://user:password@host:5432/database"

# (اختياري) الرابط العام لمخزن الصور في Supabase Storage. إن تُرك فارغاً
# أثناء التطوير، تُقرأ الصور من public/product-images محلياً بدل ذلك.
NEXT_PUBLIC_SUPABASE_STORAGE_URL=""

# ---------------------------------------------------------------------------
# لوحة الإدارة (/admin) — تحتاج مشروع Supabase حقيقي لتفعيل تسجيل الدخول.
# بدون هذه القيم الثلاث، لوحة الإدارة تبقى مقفلة بالكامل تلقائياً (لا يوجد
# أي باب دخول بديل أو تجريبي). راجع README لخطوات الإعداد اليدوية.
# ---------------------------------------------------------------------------

# رابط مشروع Supabase ومفتاحه العام (anon key). آمنان للظهور في المتصفح
# (هذا هو تصميم Supabase نفسه)، لكن لا فائدة منهما بدون مشروع حقيقي.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# مفتاح الخادم السري (service role) من Supabase — لرفع صور المنتجات إلى
# Supabase Storage فقط. يُستعمل من كود الخادم حصرياً ولا يظهر أبداً في
# المتصفح أو في أي كود عميل. لا تشاركه مع أحد ولا تضعه إلا في .env.local.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Meta Pixel (Facebook/Instagram/WhatsApp) — لتتبع PageView/ViewContent/
# AddToCart/InitiateCheckout/Purchase. اختياري: بدون هذه القيمة، لا يُحمَّل
# أي سكريبت Pixel إطلاقاً (بدل تحميله بمعرّف فارغ/خاطئ).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=""

# Meta Conversions API (CAPI) — يُكمِّل Pixel بإرسال نفس الأحداث من الخادم
# (أوثق، لا يتأثر بحاجب الإعلانات). سرّي بالكامل: خادم فقط، ممنوع أي بادئة
# NEXT_PUBLIC_ (لن يظهر فالمتصفح أبداً). اختياري: بدونه، Purchase من CAPI لا
# يُرسَل إطلاقاً (Pixel من المتصفح يستمر يعمل بشكل طبيعي بلا أي تأثير).
META_CONVERSIONS_API_ACCESS_TOKEN=""

# مؤقت — لاختبار CAPI عبر Meta Events Manager → Test Events فقط. إذا وُجد،
# يُرسَل كـtest_event_code مع كل حدث خادم؛ إذا تُرك فارغاً، لا تغيير إطلاقاً
# فالسلوك الحالي (لا يُرسَل test_event_code إطلاقاً). أزِله بعد انتهاء
# الاختبار — لا يجب أن يبقى مضبوطاً في Production الحقيقي.
META_TEST_EVENT_CODE=""

# GA4 Measurement Protocol — يُرسِل حدث purchase إلى GA4 من الخادم فور حفظ
# الطلب، بدل الاعتماد على بقاء صفحة المتصفح مفتوحة بعد الضغط على "إرسال".
# سرّي بالكامل: خادم فقط، ممنوع أي بادئة NEXT_PUBLIC_.
#
# يُنشأ من: GA4 → Admin → Data Streams → (الموقع) → Measurement Protocol API
# secrets → Create.
#
# **صار إلزامياً لأي شراء في GA4.** لم يبقَ للمتصفح احتياط: كان يُرسل
# purchase لحظة إرسال الطلب، أي بيعةً تُعلَن قبل أن يؤكّدها الزبون في
# واتساب — نفس الخطأ الذي أُصلح في Meta. فصار الشراء يُرسَل من الخادم عند
# التأكيد التجاري وحده (lib/pixel/sendDeferredPurchase.ts)، وذلك المسار
# يمرّ من هنا. فبلا هذا السرّ لا يسجّل GA4 أي purchase إطلاقاً.
#
# وما لا يتأثّر: القياس الداخلي في Supabase (`analytics_events` وجداول
# الطلبات) هو مرجع القُمع في /admin/reports، ولا يعتمد على GA4 في شيء.
GA4_API_SECRET=""

# ---------------------------------------------------------------------------
# فرع اختبار نمط اتصال Supavisor (test/session-mode-5432) — اختياريان تماماً.
# بدونهما يبقى سلوك قاعدة البيانات **حرفياً** كما هو في الإنتاج: مجمّع بحجم
# 5 ومهلة بدء statement_timeout=8000. يُحذفان مع حذف مسار التشخيص.
# ---------------------------------------------------------------------------

# حجم مجمّع postgres.js. يُقبَل عدد صحيح من 1 إلى 10؛ أي قيمة أخرى تعود إلى 5.
# الغرض: مقارنة max=1 بـmax=2 على منفذ الجلسة 5432، حيث كل اتصال عميل يحجز
# خادماً كاملاً خلف Supavisor فيصير حجم المجمّع قراراً له ثمن مقيس.
DB_POOL_MAX="5"

# هل يُرسَل statement_timeout كمعامل بدء اتصال؟ قيمة بالميلّي ثانية
# (1000..120000)، أو "off" لعدم إرساله إطلاقاً. مجمّع المعاملات يرفض هذا
# المعامل أصلاً (08P01)، وتغيير المنفذ إلى 5432 وحده لا يضمن قبوله — فالقيمة
# "off" تتيح اختبار الحالتين على نفس النشر.
DB_STATEMENT_TIMEOUT_MS="8000"

# (فرع الاختبار وحده) رابط اتصال بديل يُستعمل بدل DATABASE_URL — لاختبار
# نمط الجلسة على المنفذ 5432 دون لمس إعداد المعاينة العام. مفتاح جديد
# بالكامل، فلا يتعارض مع DATABASE_URL في واجهة Vercel. ويُتجاهَل تماماً في
# أي نشر إنتاجي أو أي معاينة غير متّصلة بمشروع Supabase المعزول.
DATABASE_URL_SESSION_TEST=""
